{
    # Automatically requests Let's Encrypt certificates for any custom domain
    # only after checking with backend that the domain is registered.
    on_demand_tls {
        ask http://backend:8080/api/internal/check-domain
    }
}

# 1. Admin Console
{$CONSOLE_DOMAIN:console.localhost} {
    reverse_proxy console:3000
}

# 2. Main API & Dynamic Blog Subdomains (*.yourdomain.com)
*.{$BASE_DOMAIN:localhost}, {$BASE_DOMAIN:localhost} {
    reverse_proxy backend:8080
}

# 3. Dynamic Custom Domains (e.g. blog.client.com)
:443 {
    tls {
        on_demand
    }
    reverse_proxy backend:8080
}
