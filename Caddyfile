{
    # Automatically requests Let's Encrypt certificates for any custom domain
    # only after checking with backend that the domain is registered.
    on_demand_tls {
        ask http://backend:8080/api/internal/check-domain
    }
}

# Reusable security headers snippet
(security_headers) {
    header {
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Referrer policy for external links
        Referrer-Policy "strict-origin-when-cross-origin"
        # XSS filter protection
        X-XSS-Protection "1; mode=block"
    }
}

# 1. Admin Console
{$CONSOLE_DOMAIN:console.localhost} {
    import security_headers
    encode zstd gzip

    @static path /_next/static/*
    header @static Cache-Control "public, max-age=31536000, immutable"

    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /uploads/* {
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy console:3000
    }
}

# 2. Main API & Dynamic Blog Subdomains (*.yourdomain.com)
*.{$BASE_DOMAIN:localhost}, {$BASE_DOMAIN:localhost} {
    import security_headers
    encode zstd gzip

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy backend:8080
}

# 3. Dynamic Custom Domains (e.g. blog.client.com)
:443 {
    import security_headers
    tls {
        on_demand
    }
    encode zstd gzip

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy backend:8080
}
