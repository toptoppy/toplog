# Domain configuration
BASE_DOMAIN=localhost
CONSOLE_DOMAIN=console.localhost

# Database Credentials
DB_USER=postgres
DB_PASSWORD=supersecurepassword123
DB_NAME=blogdb

# Security & JWT
JWT_SECRET=super-secret-jwt-key-replace-with-a-random-32-char-string-in-prod
JWT_ISSUER=blogs-backend
JWT_AUDIENCE=blogs-console

# Storage
STORAGE_UPLOADS_DIR=/app/uploads

# AI Assistant (OpenRouter, OpenAI, Groq, DeepSeek, etc.)
# Option 1: OpenRouter (First-class support - defaults to google/gemini-2.0-flash-001)
OPENROUTER_API_KEY=
# Option 2: OpenAI / Custom OpenAI-compatible endpoint
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
