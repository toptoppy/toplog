<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ blog.title }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ blog.description }}{% endblock %}">
    {% if blog.faviconUrl %}
    <link rel="icon" href="{{ blog.faviconUrl }}">
    {% endif %}
    <link rel="stylesheet" href="/assets/style.css">
    <link rel="alternate" type="application/atom+xml" title="{{ blog.title }} Feed" href="/feed.atom">

    <!-- Open Graph & Twitter Social Card Meta Tags -->
    <meta property="og:site_name" content="{{ blog.title }}">
    <meta property="og:type" content="article">
    <meta property="og:title" content="{% block og_title %}{{ blog.title }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ blog.description }}{% endblock %}">
    {% block og_image %}
    {% if post is not empty and post.slug is not empty %}
    <meta property="og:image" content="/api/og/{{ post.slug }}">
    <meta name="twitter:image" content="/api/og/{{ post.slug }}">
    {% endif %}
    {% endblock %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% block twitter_title %}{{ blog.title }}{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}{{ blog.description }}{% endblock %}">

    {% if blog.darkModeEnabled %}
    <script>
    (function() {
        var saved = localStorage.getItem('blog_theme');
        if (saved === 'dark' || (!saved && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    })();
    </script>
    {% endif %}
    <style>
        :root {
            {% if blog.accentColor %}
            --primary-color: {{ blog.accentColor }};
            --primary-hover: {{ blog.accentColor }};
            {% endif %}
            {% if blog.fontFamily %}
            --font-sans: '{{ blog.fontFamily }}', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            {% endif %}
        }
    </style>
    {% block head %}{% endblock %}
    {% if blog.codeHead %}
        {{ blog.codeHead | raw }}
    {% endif %}
</head>
<body>
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
    <header class="site-header">
        <div class="container header-wrap">
            <div>
                {% if blog.logoUrl %}
                    <h1 class="site-title"><a href="/"><img src="{{ blog.logoUrl }}" alt="{{ blog.title }}" style="max-height: 48px; width: auto; vertical-align: middle;"></a></h1>
                {% else %}
                    <h1 class="site-title"><a href="/">{{ blog.title }}</a></h1>
                {% endif %}
                {% if blog.description %}
                    <p class="site-tagline">{{ blog.description }}</p>
                {% endif %}
            </div>
            <div class="header-actions">
                <button type="button" class="search-trigger" id="open-search-btn" aria-label="Search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <span>Search</span>
                    <span class="search-shortcut">⌘K</span>
                </button>
                {% if blog.darkModeEnabled %}
                <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" aria-label="Toggle dark mode">
                    <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
                {% endif %}
            </div>
        </div>
    </header>

    <main class="site-main container">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="newsletter-box">
                <h3>Subscribe to our Newsletter</h3>
                <p>Receive updates, new engineering essays, and product dispatches directly in your inbox.</p>
                <form id="newsletter-form" class="newsletter-form">
                    <input type="email" id="newsletter-email" class="newsletter-input" placeholder="Your email address..." required>
                    <button type="submit" id="newsletter-submit" class="newsletter-btn">Subscribe</button>
                </form>
                <div id="newsletter-status" class="newsletter-msg" style="display: none;"></div>
            </div>

            <p>&copy; {{ currentYear }} {{ blog.title }}. All rights reserved.</p>
            <p><a href="/feed.atom">RSS Feed</a> &bull; <a href="/sitemap.xml">Sitemap</a> &bull; <a href="/search">Search</a></p>
        </div>
    </footer>

    <!-- Search Modal -->
    <div id="search-modal" class="search-modal-backdrop" role="dialog" aria-modal="true">
        <div class="search-modal-box">
            <div class="search-modal-header">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" id="modal-search-input" placeholder="Search articles, topics, and guides..." autocomplete="off">
                <button type="button" id="close-search-btn" class="search-modal-close" aria-label="Close search">&times;</button>
            </div>
            <div id="modal-search-results" class="search-results-list">
                <div style="padding: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.9rem;">
                    Type to start searching...
                </div>
            </div>
        </div>
    </div>

    <script>
    (function() {
        // --- 1. Search Modal Behavior ---
        var modal = document.getElementById('search-modal');
        var openBtn = document.getElementById('open-search-btn');
        var closeBtn = document.getElementById('close-search-btn');
        var searchInput = document.getElementById('modal-search-input');
        var resultsBox = document.getElementById('modal-search-results');
        var debounceTimer;

        function openSearch() {
            modal.classList.add('active');
            searchInput.focus();
        }

        function closeSearch() {
            modal.classList.remove('active');
            searchInput.value = '';
            resultsBox.innerHTML = '<div style="padding: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.9rem;">Type to start searching...</div>';
        }

        if (openBtn) openBtn.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);

        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeSearch();
        });

        document.addEventListener('keydown', function(e) {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                if (modal.classList.contains('active')) closeSearch(); else openSearch();
            } else if (e.key === 'Escape' && modal.classList.contains('active')) {
                closeSearch();
            }
        });

        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            var q = searchInput.value.trim();
            if (!q) {
                resultsBox.innerHTML = '<div style="padding: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.9rem;">Type to start searching...</div>';
                return;
            }

            debounceTimer = setTimeout(function() {
                resultsBox.innerHTML = '<div style="padding: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.9rem;">Searching...</div>';
                fetch('/api/search?q=' + encodeURIComponent(q))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (!data.results || data.results.length === 0) {
                            resultsBox.innerHTML = '<div style="padding: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.9rem;">No articles found matching "' + q + '"</div>';
                            return;
                        }
                        var html = '';
                        data.results.forEach(function(item) {
                            html += '<a href="/' + item.slug + '" class="search-result-item">';
                            html += '<div class="search-result-title">' + (item.title || 'Untitled') + '</div>';
                            if (item.description) {
                                html += '<div class="search-result-desc">' + item.description + '</div>';
                            }
                            html += '</a>';
                        });
                        resultsBox.innerHTML = html;
                    })
                    .catch(function() {
                        resultsBox.innerHTML = '<div style="padding: 1.5rem; text-align: center; color: #dc2626; font-size: 0.9rem;">Search error. Please try again.</div>';
                    });
            }, 250);
        });

        // --- 2. Newsletter Subscription Form ---
        var newsForm = document.getElementById('newsletter-form');
        var newsEmail = document.getElementById('newsletter-email');
        var newsSubmit = document.getElementById('newsletter-submit');
        var newsStatus = document.getElementById('newsletter-status');

        if (newsForm) {
            newsForm.addEventListener('submit', function(e) {
                e.preventDefault();
                var email = newsEmail.value.trim();
                if (!email) return;

                newsSubmit.disabled = true;
                newsSubmit.innerText = 'Subscribing...';
                newsStatus.style.display = 'none';

                fetch('/api/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    newsStatus.style.display = 'block';
                    if (data.success) {
                        newsStatus.className = 'newsletter-msg success';
                        newsStatus.innerText = data.message || 'Subscribed successfully!';
                        newsEmail.value = '';
                    } else {
                        newsStatus.className = 'newsletter-msg error';
                        newsStatus.innerText = data.error || data.message || 'Subscription failed.';
                    }
                })
                .catch(function() {
                    newsStatus.style.display = 'block';
                    newsStatus.className = 'newsletter-msg error';
                    newsStatus.innerText = 'Could not subscribe. Please try again later.';
                })
                .finally(function() {
                    newsSubmit.disabled = false;
                    newsSubmit.innerText = 'Subscribe';
                });
            });
        }

        // --- 3. Privacy-Preserving Analytics Beacon ---
        try {
            var analyticsPayload = {
                path: window.location.pathname,
                referrer: document.referrer || null,
                postId: {% if postId != null %}{{ postId }}{% else %}null{% endif %}
            };
            if (navigator.sendBeacon) {
                var blob = new Blob([JSON.stringify(analyticsPayload)], { type: 'application/json' });
                navigator.sendBeacon('/api/analytics/view', blob);
            } else {
                fetch('/api/analytics/view', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(analyticsPayload),
                    keepalive: true
                });
            }
        } catch (err) {
            // Silently ignore tracking errors
        }
        // --- 4. Dark Mode & Reading Progress Bar ---
        var themeBtn = document.getElementById('theme-toggle-btn');
        if (themeBtn) {
            themeBtn.addEventListener('click', function() {
                var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                var next = isDark ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('blog_theme', next);
            });
        }

        var progBar = document.getElementById('reading-progress-bar');
        if (progBar) {
            window.addEventListener('scroll', function() {
                var docH = document.documentElement.scrollHeight - window.innerHeight;
                var pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
                progBar.style.width = Math.min(100, Math.max(0, pct)) + '%';
            }, { passive: true });
        }
    })();
    </script>

    {% if blog.codeFoot %}
        {{ blog.codeFoot | raw }}
    {% endif %}
</body>
</html>
