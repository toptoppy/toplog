{% extends "themes/default/layout.pebble" %}

{% block title %}Unsubscribe - {{ blog.title }}{% endblock %}

{% block content %}
<div class="page-card">
    <div style="max-width: 460px; margin: 0 auto;">
        {% if success %}
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">👋</div>
            <h1 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text-color);">Unsubscribed</h1>
            <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.5; margin-bottom: 1.5rem;">
                {{ message }}
            </p>
            <p style="font-size: 0.9rem; color: var(--text-muted);">
                Changed your mind? You can always resubscribe using the form in the footer.
            </p>
        {% else %}
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">⚠️</div>
            <h1 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; color: #dc2626;">Unsubscribe Failed</h1>
            <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.5; margin-bottom: 1.5rem;">
                {{ message }}
            </p>
        {% endif %}
        <div style="margin-top: 2rem;">
            <a href="/" class="read-more">&larr; Return to {{ blog.title }}</a>
        </div>
    </div>
</div>
{% endblock %}
