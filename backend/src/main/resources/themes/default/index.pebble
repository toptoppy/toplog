{% extends "themes/default/layout.pebble" %}

{% block content %}
{% if tags is not empty %}
<nav class="home-tag-bar" aria-label="Topic navigation">
    <a href="/" class="home-tag-pill active">All Stories</a>
    {% for t in tags %}
        <a href="/tag/{{ t.slug }}" class="home-tag-pill">#{{ t.name }} <span class="home-tag-count">{{ t.postCount }}</span></a>
    {% endfor %}
</nav>
{% endif %}

<section class="post-list">
    {% if posts is empty %}
        <div class="empty-state">
            <p>No posts published yet.</p>
        </div>
    {% else %}
        {% for post in posts %}
            <article class="post-card {% if post.isFeatured %}featured{% endif %}">
                {% if post.featuredImageUrl %}
                    <a href="/{{ post.slug }}" class="post-thumbnail">
                        <img src="{{ post.featuredImageUrl }}" alt="{{ post.title }}" loading="lazy">
                    </a>
                {% endif %}
                <div class="post-card-body">
                    {% if post.isFeatured %}
                        <span class="badge badge-featured">Featured</span>
                    {% endif %}
                    <h2><a href="/{{ post.slug }}">{{ post.title }}</a></h2>
                    <div class="post-meta">
                        <time datetime="{{ post.publishedAt }}">{{ post.publishedAtFormatted }}</time>
                        {% if post.readingTimeMinutes %}
                            <span class="reading-time">&bull; {{ post.readingTimeMinutes }} min read</span>
                        {% endif %}
                    </div>
                    {% if post.description %}
                        <p class="post-excerpt">{{ post.description }}</p>
                    {% endif %}
                    <a href="/{{ post.slug }}" class="read-more">Read full story &rarr;</a>
                </div>
            </article>
        {% endfor %}
    {% endif %}
</section>
{% endblock %}
