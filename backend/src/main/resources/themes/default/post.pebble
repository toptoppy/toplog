{% extends "themes/default/layout.pebble" %}

{% block title %}{{ post.title }} - {{ blog.title }}{% endblock %}
{% block description %}{{ post.description }}{% endblock %}

{% block content %}
<article class="single-post">
    <header class="post-header">
        <h1>{{ post.title }}</h1>
        <div class="post-meta">
            <time datetime="{{ post.publishedAt }}">Published on {{ post.publishedAtFormatted }}</time>
            <span class="reading-time">&bull; {{ readingTimeMinutes }} min read</span>
            {% if tags is not empty %}
                <span class="post-tags">
                    in
                    {% for tag in tags %}
                        <a href="/tag/{{ tag.slug }}" class="tag-pill">{{ tag.name }}</a>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </span>
            {% endif %}
        </div>

        <!-- 1-Click Social Sharing Toolbar -->
        <div class="social-share-toolbar">
            <span class="share-label">Share:</span>
            <button type="button" class="share-btn share-copy" id="share-copy-btn" title="Copy article link">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                <span id="share-copy-label">Copy link</span>
            </button>
            <a href="#" id="share-x-link" target="_blank" rel="noopener noreferrer" class="share-btn share-x" title="Share on X / Twitter">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                <span>Post</span>
            </a>
            <a href="#" id="share-li-link" target="_blank" rel="noopener noreferrer" class="share-btn share-li" title="Share on LinkedIn">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                <span>LinkedIn</span>
            </a>
            <a href="#" id="share-fb-link" target="_blank" rel="noopener noreferrer" class="share-btn share-fb" title="Share on Facebook">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                <span>Share</span>
            </a>
        </div>
    </header>

    {% if post.featuredImageUrl %}
        <figure class="post-featured-image">
            <img src="{{ post.featuredImageUrl }}" alt="{{ post.title }}">
        </figure>
    {% endif %}

    <!-- Auto-Generated Table of Contents -->
    <aside class="post-toc" id="post-toc" style="display: none;">
        <div class="toc-header">
            <h3>Table of Contents</h3>
            <button type="button" id="toc-toggle-btn" class="toc-toggle" title="Toggle Table of Contents">Hide</button>
        </div>
        <ul id="toc-list"></ul>
    </aside>

    <div class="post-body" id="post-article-body">
        {{ post.contentHtml | raw }}
    </div>

    <!-- Author Editorial Bio Signature -->
    <div class="post-author-bio">
        {% if blog.logoUrl %}
            <img src="{{ blog.logoUrl }}" alt="{{ blog.title }}" class="author-bio-avatar">
        {% else %}
            <div class="author-bio-avatar-fallback">{{ blog.title | slice(0, 1) }}</div>
        {% endif %}
        <div class="author-bio-info">
            <h4 class="author-bio-name">Written by {{ blog.title }}</h4>
            <p class="author-bio-desc">{% if blog.description %}{{ blog.description }}{% else %}Publishing insightful essays, engineering guides, and deep perspectives.{% endif %}</p>
        </div>
    </div>

    <!-- Inline Newsletter Subscription Card -->
    <section class="post-newsletter-card">
        <div class="newsletter-card-inner">
            <div class="newsletter-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="newsletter-copy">
                <h3>Subscribe to {{ blog.title }}</h3>
                <p>Enjoyed this essay? Receive future stories and updates directly in your inbox. No spam, unsubscribe anytime.</p>
            </div>
        </div>
        <form id="post-subscribe-form" class="newsletter-form">
            <input type="email" id="post-subscribe-email" placeholder="Your email address" required class="newsletter-input">
            <button type="submit" id="post-subscribe-btn" class="newsletter-btn">Subscribe</button>
        </form>
        <div id="post-subscribe-msg" class="newsletter-msg" style="display: none;"></div>
    </section>

    <!-- Recommended / Related Stories Grid -->
    {% if relatedPosts is not empty %}
    <section class="related-stories-section">
        <div class="related-stories-header">
            <h2>Recommended Stories</h2>
            <span class="related-stories-subtitle">More articles from {{ blog.title }}</span>
        </div>
        <div class="related-stories-grid">
            {% for rel in relatedPosts %}
                <article class="related-story-card">
                    {% if rel.featuredImageUrl %}
                        <a href="/{{ rel.slug }}" class="related-story-thumb">
                            <img src="{{ rel.featuredImageUrl }}" alt="{{ rel.title }}" loading="lazy">
                        </a>
                    {% endif %}
                    <div class="related-story-content">
                        {% if rel.tags is not empty %}
                            <span class="related-story-tag">#{{ rel.tags[0].name }}</span>
                        {% endif %}
                        <h3><a href="/{{ rel.slug }}">{{ rel.title }}</a></h3>
                        <div class="related-story-meta">
                            <span>{{ rel.publishedAtFormatted }}</span>
                            <span>&bull; {{ rel.readingTimeMinutes }} min read</span>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- Reader Comments Section -->
    <section class="comments-section" id="comments">
        <h2 class="comments-title">Comments ({% if comments is empty %}0{% else %}{{ comments.size() }}{% endif %})</h2>

        {% if comments is not empty %}
            <div class="comments-list">
                {% for comment in comments %}
                    <div class="comment-card" id="comment-{{ comment.id }}">
                        <div class="comment-header">
                            <span class="comment-author">
                                {% if comment.authorWebsite %}
                                    <a href="{{ comment.authorWebsite }}" target="_blank" rel="nofollow noopener">{{ comment.authorName }}</a>
                                {% else %}
                                    {{ comment.authorName }}
                                {% endif %}
                            </span>
                            <time class="comment-date">{{ comment.createdAt }}</time>
                        </div>
                        <div class="comment-body">
                            {{ comment.content }}
                        </div>

                        <!-- Nested Replies -->
                        {% if comment.replies is not empty %}
                            <div class="comment-replies">
                                {% for reply in comment.replies %}
                                    <div class="comment-card comment-reply" id="comment-{{ reply.id }}">
                                        <div class="comment-header">
                                            <span class="comment-author">{{ reply.authorName }}</span>
                                            <time class="comment-date">{{ reply.createdAt }}</time>
                                        </div>
                                        <div class="comment-body">
                                            {{ reply.content }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p style="color: #64748b; font-size: 0.95rem;">No comments yet. Be the first to share your thoughts!</p>
        {% endif %}

        <!-- Comment Form -->
        <form id="comment-submission-form" class="comment-form">
            <h3>Leave a Reply</h3>
            <input type="hidden" id="comment-post-id" value="{{ postId }}">
            <input type="text" id="comment-honeypot" style="display:none;" tabindex="-1" autocomplete="off">

            <div class="form-grid">
                <div>
                    <input type="text" id="comment-author-name" class="comment-input" placeholder="Your Name *" required>
                </div>
                <div>
                    <input type="email" id="comment-author-email" class="comment-input" placeholder="Your Email (kept private) *" required>
                </div>
            </div>

            <div style="margin-bottom: 1rem;">
                <input type="url" id="comment-author-website" class="comment-input" placeholder="Your Website (optional)">
            </div>

            <div>
                <textarea id="comment-content" class="comment-textarea" placeholder="Write your thoughts..." required></textarea>
            </div>

            <button type="submit" id="comment-submit-btn" class="comment-btn">Post Comment</button>
            <div id="comment-form-status" class="comment-msg" style="display: none;"></div>
        </form>
    </section>

    <footer class="post-footer">
        <p><a href="/" class="back-link">&larr; Back to all posts</a></p>
    </footer>
</article>

<script>
(function() {
    var form = document.getElementById('comment-submission-form');
    var status = document.getElementById('comment-form-status');
    var submitBtn = document.getElementById('comment-submit-btn');

    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            submitBtn.disabled = true;
            submitBtn.innerText = 'Submitting...';
            status.style.display = 'none';

            var payload = {
                postId: parseInt(document.getElementById('comment-post-id').value, 10),
                authorName: document.getElementById('comment-author-name').value.trim(),
                authorEmail: document.getElementById('comment-author-email').value.trim(),
                authorWebsite: document.getElementById('comment-author-website').value.trim() || null,
                content: document.getElementById('comment-content').value.trim(),
                honeypot: document.getElementById('comment-honeypot').value.trim() || null
            };

            fetch('/api/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                status.style.display = 'block';
                if (data.success) {
                    status.className = 'comment-msg success';
                    status.innerText = data.message || 'Comment submitted! It will appear once approved.';
                    document.getElementById('comment-content').value = '';
                } else {
                    status.className = 'comment-msg error';
                    status.innerText = data.error || 'Failed to submit comment.';
                }
            })
            .catch(function() {
                status.style.display = 'block';
                status.className = 'comment-msg error';
                status.innerText = 'Could not submit comment. Please try again.';
            })
            .finally(function() {
                submitBtn.disabled = false;
                submitBtn.innerText = 'Post Comment';
            });
        });
    }

    // --- Auto-generate Table of Contents with Active Highlighting & Collapse ---
    try {
        var body = document.getElementById('post-article-body');
        var tocContainer = document.getElementById('post-toc');
        var tocList = document.getElementById('toc-list');
        var tocToggleBtn = document.getElementById('toc-toggle-btn');

        if (body && tocContainer && tocList) {
            var headings = body.querySelectorAll('h2, h3');
            if (headings.length >= 2) {
                var tocLinks = [];
                headings.forEach(function(h, idx) {
                    if (!h.id) {
                        h.id = 'heading-' + idx + '-' + h.innerText.toLowerCase().replace(/[^a-z0-9]+/g, '-');
                    }
                    var li = document.createElement('li');
                    if (h.tagName.toLowerCase() === 'h3') {
                        li.className = 'toc-h3';
                    }
                    var a = document.createElement('a');
                    a.href = '#' + h.id;
                    a.innerText = h.innerText;
                    li.appendChild(a);
                    tocList.appendChild(li);
                    tocLinks.push({ heading: h, link: a });
                });
                tocContainer.style.display = 'block';

                // Smooth scroll when clicking TOC link
                tocList.addEventListener('click', function(e) {
                    var target = e.target.closest('a');
                    if (target && target.hash) {
                        var targetEl = document.querySelector(target.hash);
                        if (targetEl) {
                            e.preventDefault();
                            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            history.pushState(null, null, target.hash);
                        }
                    }
                });

                // Toggle collapse / expand
                if (tocToggleBtn) {
                    tocToggleBtn.addEventListener('click', function() {
                        if (tocList.style.display === 'none') {
                            tocList.style.display = 'block';
                            tocToggleBtn.innerText = 'Hide';
                        } else {
                            tocList.style.display = 'none';
                            tocToggleBtn.innerText = 'Show';
                        }
                    });
                }

                // IntersectionObserver for active heading highlight
                if ('IntersectionObserver' in window && tocLinks.length > 0) {
                    var observer = new IntersectionObserver(function(entries) {
                        entries.forEach(function(entry) {
                            if (entry.isIntersecting) {
                                var matched = tocLinks.find(function(item) { return item.heading === entry.target; });
                                if (matched) {
                                    tocLinks.forEach(function(item) { item.link.classList.remove('active'); });
                                    matched.link.classList.add('active');
                                }
                            }
                        });
                    }, { rootMargin: '0px 0px -70% 0px', threshold: 0.1 });

                    headings.forEach(function(h) { observer.observe(h); });
                }
            }
        }
    } catch (e) {}

    // --- 1-Click Copy Link & Social Sharing ---
    var currentUrl = window.location.href;
    var currentTitle = document.title;
    var xLink = document.getElementById('share-x-link');
    if (xLink) xLink.href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(currentTitle) + '&url=' + encodeURIComponent(currentUrl);
    var liLink = document.getElementById('share-li-link');
    if (liLink) liLink.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(currentUrl);
    var fbLink = document.getElementById('share-fb-link');
    if (fbLink) fbLink.href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(currentUrl);

    var copyBtn = document.getElementById('share-copy-btn');
    var copyLabel = document.getElementById('share-copy-label');
    if (copyBtn && copyLabel) {
        copyBtn.addEventListener('click', function() {
            var urlToCopy = window.location.href;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(urlToCopy).then(function() {
                    copyLabel.innerText = 'Copied!';
                    copyBtn.classList.add('copied');
                    setTimeout(function() {
                        copyLabel.innerText = 'Copy link';
                        copyBtn.classList.remove('copied');
                    }, 2500);
                });
            } else {
                var temp = document.createElement('input');
                temp.value = urlToCopy;
                document.body.appendChild(temp);
                temp.select();
                document.execCommand('copy');
                document.body.removeChild(temp);
                copyLabel.innerText = 'Copied!';
                setTimeout(function() {
                    copyLabel.innerText = 'Copy link';
                }, 2500);
            }
        });
    }

    // --- Post Newsletter Subscription Form ---
    var subForm = document.getElementById('post-subscribe-form');
    var subMsg = document.getElementById('post-subscribe-msg');
    var subBtn = document.getElementById('post-subscribe-btn');
    var subEmail = document.getElementById('post-subscribe-email');

    if (subForm && subMsg && subBtn && subEmail) {
        subForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var emailVal = subEmail.value.trim();
            if (!emailVal) return;

            subBtn.disabled = true;
            subBtn.innerText = 'Subscribing...';
            subMsg.style.display = 'none';

            fetch('/api/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: emailVal })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                subMsg.style.display = 'block';
                if (data.status === 'subscribed' || data.status === 'pending') {
                    subMsg.className = 'newsletter-msg success';
                    subMsg.innerText = data.message || 'Thank you for subscribing!';
                    subEmail.value = '';
                } else if (data.error) {
                    subMsg.className = 'newsletter-msg error';
                    subMsg.innerText = data.error;
                } else {
                    subMsg.className = 'newsletter-msg success';
                    subMsg.innerText = 'Thank you for subscribing!';
                    subEmail.value = '';
                }
            })
            .catch(function() {
                subMsg.style.display = 'block';
                subMsg.className = 'newsletter-msg error';
                subMsg.innerText = 'Failed to subscribe. Please try again.';
            })
            .finally(function() {
                subBtn.disabled = false;
                subBtn.innerText = 'Subscribe';
            });
        });
    }
})();
</script>
{% endblock %}
